<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AlarmSystem.Application\AlarmSystem.Application.csproj" />
    <ProjectReference Include="..\..\src\AlarmSystem.Infrastructure\AlarmSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\AlarmSystem.DatabaseTool\AlarmSystem.DatabaseTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\templates\teams-alarm-card.json"
             Link="templates\teams-alarm-card.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\templates\line-alarm-card.json"
             Link="templates\line-alarm-card.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\templates\email-alarm.html"
             Link="templates\email-alarm.html"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
