<Window x:Class="AlarmSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:AlarmSystem.Domain.Events;assembly=AlarmSystem.Domain"
        xmlns:resources="clr-namespace:AlarmSystem.Desktop.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.WindowTitle}"
        Width="1040"
        Height="900"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#7A271A" />
        </Style>
    </Window.Resources>

    <TabControl>
      <TabItem Header="{x:Static resources:Strings.LineTabHeader}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{x:Static resources:Strings.ToolNotice}"
                       Margin="0,0,0,8"
                       Padding="12"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#7A271A"
                       Background="#FEF0C7" />
            <TextBlock Text="{Binding ManualTestLicenseNotice}"
                       Margin="0,0,0,14"
                       Padding="12"
                       TextWrapping="Wrap"
                       FontWeight="Bold"
                       Foreground="#7A271A"
                       Background="#FEE4E2"
                       AutomationProperties.Name="{x:Static resources:Strings.ManualTestLicenseNotice}" />

            <GroupBox Header="{x:Static resources:Strings.ConnectionSection}"
                      IsEnabled="{Binding IsNotSending}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Target="{Binding ElementName=GroupIdTextBox}"
                           Content="{x:Static resources:Strings.GroupIdLabel}" />
                    <TextBox x:Name="GroupIdTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Target="{Binding ElementName=ChannelAccessTokenPasswordBox}"
                           Content="{x:Static resources:Strings.ChannelAccessTokenLabel}" />
                    <PasswordBox x:Name="ChannelAccessTokenPasswordBox"
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="4"
                                 Padding="7,5"
                                 AutomationProperties.Name="{x:Static resources:Strings.ChannelAccessTokenLabel}"
                                 PasswordChanged="ChannelAccessTokenPasswordBox_OnPasswordChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="5,0,5,6"
                               Text="{x:Static resources:Strings.TokenSecurityHint}"
                               TextWrapping="Wrap"
                               Foreground="#475467" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Content="{x:Static resources:Strings.ApiEndpointLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding ApiEndpoint, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False" />

                    <Label Grid.Row="4" Grid.Column="0"
                           Target="{Binding ElementName=TimeoutTextBox}"
                           Content="{x:Static resources:Strings.TimeoutSecondsLabel}" />
                    <TextBox x:Name="TimeoutTextBox"
                             Grid.Row="4" Grid.Column="1"
                             MaxWidth="160"
                             HorizontalAlignment="Left"
                             Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resources:Strings.AlarmSection}"
                      IsEnabled="{Binding IsNotSending}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Target="{Binding ElementName=EventIdTextBox}"
                           Content="{x:Static resources:Strings.EventIdLabel}" />
                    <TextBox x:Name="EventIdTextBox"
                             Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding EventIdText, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Target="{Binding ElementName=TagTextBox}"
                           Content="{x:Static resources:Strings.TagLabel}" />
                    <TextBox x:Name="TagTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="1" Grid.Column="2"
                           Target="{Binding ElementName=AreaTextBox}"
                           Content="{x:Static resources:Strings.AreaLabel}" />
                    <TextBox x:Name="AreaTextBox"
                             Grid.Row="1" Grid.Column="3"
                             Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Target="{Binding ElementName=EquipmentTextBox}"
                           Content="{x:Static resources:Strings.EquipmentLabel}" />
                    <TextBox x:Name="EquipmentTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="2" Grid.Column="2"
                           Target="{Binding ElementName=SourceTimestampTextBox}"
                           Content="{x:Static resources:Strings.SourceTimestampLabel}" />
                    <TextBox x:Name="SourceTimestampTextBox"
                             Grid.Row="2" Grid.Column="3"
                             Text="{Binding SourceTimestampText, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="3" Grid.Column="0"
                           Target="{Binding ElementName=EventTypeComboBox}"
                           Content="{x:Static resources:Strings.EventTypeLabel}" />
                    <ComboBox x:Name="EventTypeComboBox"
                              Grid.Row="3" Grid.Column="1"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedEventType, Mode=TwoWay}">
                        <ComboBoxItem Tag="{x:Static domain:AlarmEventType.Alarm}"
                                      Content="{x:Static resources:Strings.EventTypeAlarm}" />
                        <ComboBoxItem Tag="{x:Static domain:AlarmEventType.Ack}"
                                      Content="{x:Static resources:Strings.EventTypeAck}" />
                    </ComboBox>
                    <Label Grid.Row="3" Grid.Column="2"
                           Target="{Binding ElementName=SeverityComboBox}"
                           Content="{x:Static resources:Strings.SeverityLabel}" />
                    <ComboBox x:Name="SeverityComboBox"
                              Grid.Row="3" Grid.Column="3"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedSeverity, Mode=TwoWay}">
                        <ComboBoxItem Tag="{x:Static domain:AlarmSeverity.High}"
                                      Content="{x:Static resources:Strings.SeverityHigh}" />
                        <ComboBoxItem Tag="{x:Static domain:AlarmSeverity.Medium}"
                                      Content="{x:Static resources:Strings.SeverityMedium}" />
                        <ComboBoxItem Tag="{x:Static domain:AlarmSeverity.Low}"
                                      Content="{x:Static resources:Strings.SeverityLow}" />
                    </ComboBox>

                    <Label Grid.Row="4" Grid.Column="0"
                           VerticalAlignment="Top"
                           Target="{Binding ElementName=MessageTextBox}"
                           Content="{x:Static resources:Strings.MessageLabel}" />
                    <TextBox x:Name="MessageTextBox"
                             Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                             MinHeight="90"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static resources:Strings.PreviewSection}">
                <StackPanel>
                    <TextBox MinHeight="230"
                             MaxHeight="420"
                             IsReadOnly="True"
                             IsTabStop="False"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding PreviewText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static resources:Strings.NewTestDataButton}"
                                Command="{Binding NewTestDataCommand}" />
                        <Button Content="{x:Static resources:Strings.UpdatePreviewButton}"
                                Command="{Binding UpdatePreviewCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resources:Strings.SendSection}">
                <StackPanel>
                    <CheckBox Margin="4,2,4,10"
                              IsEnabled="{Binding IsNotSending}"
                              IsChecked="{Binding IsRealSendConfirmed, Mode=TwoWay}"
                              Content="{x:Static resources:Strings.RealSendConfirmationCheckbox}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static resources:Strings.CancelButton}"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource WarningButtonStyle}"
                                Content="{x:Static resources:Strings.SendTestMessageButton}"
                                IsEnabled="{Binding CanSend}"
                                IsDefault="False"
                                Click="SendButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resources:Strings.ResultSection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Content="{x:Static resources:Strings.StatusMessageLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Margin="5"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Text="{Binding StatusMessage}" />
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="{x:Static resources:Strings.SendStatusLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="5"
                               Text="{Binding LastSendStatusDisplay}" />
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="{x:Static resources:Strings.ErrorCodeLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="5"
                               Text="{Binding LastErrorCodeDisplay}" />
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="{x:Static resources:Strings.HttpStatusCodeLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="5"
                               Text="{Binding LastHttpStatusCodeDisplay}" />
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="{x:Static resources:Strings.ExternalMessageIdLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="5"
                               TextWrapping="Wrap"
                               Text="{Binding LastExternalMessageIdDisplay}" />
                    <Label Grid.Row="5" Grid.Column="0"
                           Content="{x:Static resources:Strings.ElapsedTimeLabel}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="5"
                               Text="{Binding ElapsedTimeDisplay}" />
                </Grid>
            </GroupBox>
        </StackPanel>
       </ScrollViewer>
      </TabItem>

      <TabItem x:Name="EmailTab"
               Header="{x:Static resources:Strings.EmailTabHeader}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
          <TextBlock Text="{x:Static resources:Strings.EmailToolNotice}"
                     Margin="0,0,0,14"
                     Padding="12"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold"
                     Foreground="#7A271A"
                     Background="#FEF0C7" />

          <GroupBox Header="{x:Static resources:Strings.EmailConnectionSection}"
                    IsEnabled="{Binding IsNotBusy}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Label Grid.Row="0" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailHostLabel}" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
              <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAdvancedSmtpSettings}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="235" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Content="{x:Static resources:Strings.EmailPortLabel}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StandardSmtpPorts}"
                          SelectedItem="{Binding SelectedStandardSmtpPort}" />
              </Grid>
              <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAdvancedSmtpSettings}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="235" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Content="{x:Static resources:Strings.EmailSecurityModeLabel}" />
                <TextBox Grid.Column="1"
                         IsReadOnly="True"
                         IsTabStop="False"
                         Text="{Binding ActiveSecurityModeDisplay, Mode=OneWay}" />
              </Grid>
              <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="4,6,4,8"
                        Header="{x:Static resources:Strings.EmailAdvancedSettingsHeader}"
                        IsExpanded="{Binding IsAdvancedSmtpSettings, Mode=TwoWay}">
                <StackPanel Margin="8,8,0,0">
                  <TextBlock Margin="4,0,4,8"
                             Foreground="#475467"
                             TextWrapping="Wrap"
                             Text="{x:Static resources:Strings.EmailAdvancedSettingsHint}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="223" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="{x:Static resources:Strings.EmailPortLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding SmtpPortText, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="{x:Static resources:Strings.EmailSecurityModeLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding SecurityModes}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedSecurityMode}" />
                    <CheckBox Grid.Row="2" Grid.Column="1"
                              Margin="5"
                              Content="{x:Static resources:Strings.EmailAllowUnencryptedRelay}"
                              IsEnabled="{Binding IsUnencryptedRelay}"
                              IsChecked="{Binding AllowUnencryptedInternalRelay}" />
                  </Grid>
                </StackPanel>
              </Expander>
              <Label Grid.Row="4" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailAuthenticationModeLabel}" />
              <ComboBox Grid.Row="4" Grid.Column="1"
                        ItemsSource="{Binding AuthenticationModes}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding SelectedAuthenticationMode}" />
              <Label Grid.Row="5" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailUsernameLabel}" />
              <TextBox Grid.Row="5" Grid.Column="1"
                       IsEnabled="{Binding UsesPasswordAuthentication}"
                       Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="6" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailPasswordLabel}" />
              <PasswordBox x:Name="EmailPasswordBox"
                           Grid.Row="6" Grid.Column="1"
                           Margin="4"
                           Padding="7,5"
                           IsEnabled="{Binding UsesPasswordAuthentication}" />
              <TextBlock Grid.Row="7" Grid.Column="1"
                         Margin="5,0,5,7"
                         TextWrapping="Wrap"
                         Foreground="#475467"
                         Text="{x:Static resources:Strings.EmailPasswordHint}" />
              <Label Grid.Row="8" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailSenderAddressLabel}" />
              <TextBox Grid.Row="8" Grid.Column="1"
                       Text="{Binding SenderAddress, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="9" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailSenderDisplayNameLabel}" />
              <TextBox Grid.Row="9" Grid.Column="1"
                       Text="{Binding SenderDisplayName, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="10" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailRecipientsLabel}" />
              <TextBox Grid.Row="10" Grid.Column="1"
                       MinHeight="62"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding RecipientsText, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="11" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailDestinationReferenceLabel}" />
              <TextBox Grid.Row="11" Grid.Column="1"
                       Text="{Binding DestinationReference, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="12" Grid.Column="0"
                     Content="{x:Static resources:Strings.TimeoutSecondsLabel}" />
              <TextBox Grid.Row="12" Grid.Column="1"
                       Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </GroupBox>

          <GroupBox Header="{x:Static resources:Strings.EmailConnectionTestSection}">
            <Grid>
              <Button HorizontalAlignment="Right"
                      Content="{x:Static resources:Strings.EmailTestConnectionButton}"
                      IsEnabled="{Binding CanTestConnection}"
                      Click="TestEmailConnectionButton_OnClick" />
            </Grid>
          </GroupBox>

          <GroupBox Header="{x:Static resources:Strings.AlarmSection}"
                    IsEnabled="{Binding IsNotBusy}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         Margin="5,0,5,8"
                         TextWrapping="Wrap"
                         Foreground="#475467"
                         Text="{x:Static resources:Strings.EmailAlarmOnlyNotice}" />
              <Label Grid.Row="1" Grid.Column="0"
                     Content="{x:Static resources:Strings.EventIdLabel}" />
              <TextBox Grid.Row="1" Grid.Column="1"
                       Text="{Binding EventIdText, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="2" Grid.Column="0"
                     Content="{x:Static resources:Strings.TagLabel}" />
              <TextBox Grid.Row="2" Grid.Column="1"
                       Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="3" Grid.Column="0"
                     Content="{x:Static resources:Strings.AreaLabel}" />
              <TextBox Grid.Row="3" Grid.Column="1"
                       Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="4" Grid.Column="0"
                     Content="{x:Static resources:Strings.EquipmentLabel}" />
              <TextBox Grid.Row="4" Grid.Column="1"
                       Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="5" Grid.Column="0"
                     Content="{x:Static resources:Strings.SeverityLabel}" />
              <ComboBox Grid.Row="5" Grid.Column="1"
                        ItemsSource="{Binding SeverityOptions}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding SelectedSeverity}" />
              <Label Grid.Row="6" Grid.Column="0"
                     Content="{x:Static resources:Strings.MessageLabel}" />
              <TextBox Grid.Row="6" Grid.Column="1"
                       MinHeight="68"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
              <Label Grid.Row="7" Grid.Column="0"
                     Content="{x:Static resources:Strings.SourceTimestampLabel}" />
              <TextBox Grid.Row="7" Grid.Column="1"
                       Text="{Binding SourceTimestampText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </GroupBox>

          <GroupBox Header="{x:Static resources:Strings.EmailPreviewSection}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button Content="{x:Static resources:Strings.NewTestDataButton}"
                        Command="{Binding NewTestDataCommand}" />
                <Button Content="{x:Static resources:Strings.UpdatePreviewButton}"
                        Command="{Binding UpdatePreviewCommand}" />
              </StackPanel>
              <TextBox MinHeight="260"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       Text="{Binding PreviewText, Mode=OneWay}" />
            </DockPanel>
          </GroupBox>

          <GroupBox Header="{x:Static resources:Strings.EmailSendSection}">
            <StackPanel>
              <CheckBox Margin="5,4,5,10"
                        Content="{x:Static resources:Strings.EmailRealSendConfirmationCheckbox}"
                        IsChecked="{Binding IsRealSendConfirmed}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static resources:Strings.CancelButton}"
                        Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource WarningButtonStyle}"
                        Content="{x:Static resources:Strings.EmailSendTestButton}"
                        IsEnabled="{Binding CanSend}"
                        IsDefault="False"
                        Click="SendEmailButton_OnClick" />
              </StackPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="{x:Static resources:Strings.EmailResultSection}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Label Grid.Row="0" Grid.Column="0"
                     Content="{x:Static resources:Strings.StatusMessageLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Margin="5"
                         TextWrapping="Wrap" FontWeight="SemiBold"
                         Text="{Binding StatusMessage}" />
              <Label Grid.Row="1" Grid.Column="0"
                     Content="{x:Static resources:Strings.SendStatusLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="5"
                         Text="{Binding LastSendStatusDisplay}" />
              <Label Grid.Row="2" Grid.Column="0"
                     Content="{x:Static resources:Strings.ErrorCodeLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="5"
                         Text="{Binding LastErrorCodeDisplay}" />
              <Label Grid.Row="3" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailSmtpStatusCodeLabel}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="5"
                         Text="{Binding LastSmtpStatusCodeDisplay}" />
              <Label Grid.Row="4" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailSmtpStageLabel}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Margin="5"
                         TextWrapping="Wrap"
                         Text="{Binding LastSmtpStageDisplay}" />
              <Label Grid.Row="5" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailDiagnosticLabel}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Margin="5"
                         TextWrapping="Wrap"
                         Text="{Binding LastDiagnosticDetailDisplay}" />
              <Label Grid.Row="6" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailWarningCodeLabel}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Margin="5"
                         Text="{Binding LastWarningCodeDisplay}" />
              <Label Grid.Row="7" Grid.Column="0"
                     Content="{x:Static resources:Strings.EmailCorrelationIdLabel}" />
              <TextBlock Grid.Row="7" Grid.Column="1" Margin="5"
                         Text="{Binding LastCorrelationIdDisplay}" />
            </Grid>
          </GroupBox>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
    </TabControl>
</Window>
