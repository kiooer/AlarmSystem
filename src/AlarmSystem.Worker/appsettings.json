{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AlarmPolling": {
    "Enabled": false,
    "IntervalSeconds": 5,
    "OverlapSeconds": 60,
    "MaxBatchSize": 500,
    "CommandTimeoutSeconds": 10,
    "InitialLookbackHours": 24,
    "MaxFailureBackoffSeconds": 60,
    "SourceTimeZoneId": "Taipei Standard Time",
    "SourceConfigPath": "",
    "AlarmStoreConfigPath": ""
  },
  "Licensing": {
    "Dongle": {
      "Provider": "Unconfigured",
      "CheckTimeoutSeconds": 5,
      "FeatureMapping": {
        "Line": "",
        "Teams": "",
        "Email": ""
      }
    },
    "Demo": {
      "ClockRollbackToleranceSeconds": 120,
      "MaximumLicenseBytes": 65536,
      "PipeName": "AlarmSystem.LicenseManagement.v1"
    },
    "Software": {
      "ClockRollbackToleranceSeconds": 120,
      "MaximumLicenseBytes": 65536
    }
  },
  "Notifications": {
    "Teams": {
      "Enabled": false,
      "DestinationReference": "UNCONFIGURED",
      "TemplatePath": "templates/teams-alarm-card.json",
      "TimeoutSeconds": 10
    },
    "Line": {
      "Enabled": false,
      "GroupId": "UNCONFIGURED",
      "TemplatePath": "templates/line-alarm-card.json",
      "TimeoutSeconds": 10
    },
    "Email": {
      "Enabled": false,
      "ConfigurationMode": "Standard",
      "Host": "",
      "Port": 587,
      "AllowUnencryptedInternalRelay": false,
      "AuthenticationMode": "Password",
      "Username": "",
      "SenderAddress": "",
      "SenderDisplayName": "AlarmSystem",
      "Recipients": [],
      "DestinationReference": "UNCONFIGURED",
      "TimeoutSeconds": 15,
      "TemplatePath": "templates/email-alarm.html"
    }
  }
}
